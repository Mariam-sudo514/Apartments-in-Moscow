    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
